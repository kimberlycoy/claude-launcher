<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Keeps server.mjs running on 127.0.0.1:8766; `tailscale serve --set-path /rc` exposes it to the tailnet.
     __REPO__ is replaced with this folder's path at install time; see README.md. -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>local.claude-launcher</string>
  <key>ProgramArguments</key>
  <array>
    <string>/opt/homebrew/bin/node</string>
    <string>__REPO__/server.mjs</string>
  </array>
  <key>WorkingDirectory</key>
  <string>__REPO__</string>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>30</integer>
  <key>StandardErrorPath</key>
  <string>__REPO__/server.log</string>
</dict>
</plist>
